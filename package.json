{
  "name": "mungit",
  "author": "Sten Feldman <exile@chamber.ee>",
  "contributors": [
    "Fredrik Norén <fredrik.jw.noren@gmail.com>",
    "Sten Feldman <exile@chamber.ee> (http://sten.feldman.eesti.ee/)"
  ],
  "description": "Git made easy, a fork of ungit",
  "version": "1.4.0",
  "ungitPluginApiVersion": "0.2.0",
  "scripts": {
    "start": "node ./bin/mungit",
    "inspect": "node --inspect ./source/server.js",
    "test": "npm run unittest && npm run clicktest",
    "unittest": "mocha --config .mochatest.json",
    "clicktest": "mocha --config .mochaclicktest.json",
    "coverage": "nyc npm run unittest",
    "lint": "eslint .",
    "format": "npm run lint -- --fix",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && node --trace-deprecation ./scripts/build.js",
    "watch": "nodemon -C --exec \"npm run build\" -e js,scss -w public/source -w public/scss -w components/ -i \"*.bundle.js\"",
    "bumpdependencies": "ncu --upgrade --reject jquery",
    "electronpackage": "node ./scripts/electronpackage.js",
    "electronzip": "node ./scripts/electronzip.js",
    "clean": "rm -rf public/css public/js; find ./components -name '*.bundle.js' | xargs rm; find ./components -name '*.map' | xargs rm; find ./components -name '*.css' | xargs rm"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/exsilium/mungit.git"
  },
  "bin": {
    "mungit": "./bin/mungit",
    "0mungit-credentials-helper": "./bin/credentials-helper"
  },
  "dependencies": {
    "@primer/octicons": "~19.31.0",
    "blueimp-md5": "~2.19.0",
    "body-parser": "~2.2.2",
    "bootstrap": "~5.3.8",
    "chokidar": "~5.0.0",
    "cookie-parser": "~1.4.7",
    "crossroads": "~0.12.2",
    "diff2html": "~3.4.56",
    "dnd-page-scroll": "0.0.4",
    "esbuild": "~0.28.1",
    "express": "~5.2.1",
    "express-session": "~1.19.0",
    "getmac": "~6.6.0",
    "hasher": "~1.2.0",
    "ignore": "~7.0.5",
    "jquery": "~4.0.0",
    "jquery-ui": "~1.14.2",
    "jsonwebtoken": "~9.0.0",
    "just-detect-adblock": "~1.1.0",
    "knockout": "~3.5.1",
    "latest-version": "~9.0.0",
    "lodash": "~4.18.1",
    "memorystore": "~1.6.7",
    "mkdirp": "~3.0.1",
    "moment": "~2.30.1",
    "node-cache": "~5.1.2",
    "nprogress": "~0.2.0",
    "open": "~11.0.0",
    "p-limit": "~7.3.0",
    "passport": "~0.7.0",
    "passport-local": "~1.0.0",
    "raven-js": "~3.27.2",
    "rc": "~1.2.8",
    "rimraf": "~6.1.3",
    "semver": "~7.8.5",
    "serve-static": "~2.2.1",
    "signals": "~1.0.0",
    "snapsvg": "~0.5.1",
    "socket.io": "~4.8.3",
    "temp": "~0.9.4",
    "typescript": "~7.0.2",
    "winston": "~3.19.0",
    "yargs": "~18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "~10.0.1",
    "@homer0/prettier-plugin-jsdoc": "~11.0.2",
    "archiver": "~8.0.0",
    "browserify": "~17.0.1",
    "dedent": "~1.7.1",
    "electron": "~43.2.0",
    "electron-packager": "~17.1.2",
    "eslint": "~10.8.0",
    "eslint-config-prettier": "~10.1.8",
    "eslint-plugin-mocha": "~12.0.0",
    "eslint-plugin-n": "~17.24.0",
    "eslint-plugin-prettier": "~5.5.5",
    "exorcist": "~2.0.0",
    "expect.js": "~0.3.1",
    "globals": "~17.9.0",
    "mocha": "~11.7.5",
    "nodemon": "~3.1.14",
    "npm-check-updates": "~23.0.0",
    "nyc": "~18.0.0",
    "portfinder": "~1.0.38",
    "prettier": "~3.9.6",
    "puppeteer": "~25.4.0",
    "sass": "~1.102.0",
    "superagent": "~10.3.0",
    "supertest": "~7.2.2"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=23"
  },
  "license": "MIT",
  "main": "public/main.js"
}
